{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobtechdev.se/semantic-taxonomy-search/benchmark-case.schema.json",
  "title": "Semantic taxonomy search benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "taxonomy_version",
    "product",
    "query",
    "query_language",
    "query_origin",
    "strata",
    "expected_intent",
    "must",
    "acceptable",
    "must_not",
    "source_evidence",
    "adjudication"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "taxonomy_version": {"type": "integer", "minimum": 1},
    "product": {"enum": ["YV", "KV"]},
    "query": {"type": "string", "minLength": 1},
    "query_language": {"type": "string", "minLength": 2, "maxLength": 16},
    "query_origin": {
      "enum": [
        "manual",
        "canonical_label",
        "canonical_definition",
        "alternative_label",
        "observed_query",
        "ad_text",
        "legacy_label",
        "synthetic"
      ]
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact_preferred_label",
          "alternative_label",
          "spelling_error",
          "swedish_compound",
          "abbreviation",
          "english_or_international",
          "colloquial",
          "task_description",
          "tool_or_method_description",
          "long_description",
          "rare_or_long_tail",
          "hard_negative",
          "broad_or_underspecified",
          "no_valid_match",
          "yv_exact_job_title",
          "yv_multi_parent_title",
          "yv_excluded_title_router",
          "yv_unbound_observed_query",
          "yv_skill_to_occupation_bridge",
          "yv_substitutability_confusable",
          "kv_description_without_canonical_term",
          "kv_occupation_to_skill_bridge",
          "kv_transferable_skill",
          "kv_relevanta_incremental_skill",
          "kv_confusable_skill",
          "legacy_deprecated_wording",
          "ad_derived_language"
        ]
      }
    },
    "expected_intent": {"enum": ["SINGLE", "AMBIGUOUS", "NO_MATCH"]},
    "must": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "acceptable": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "must_not": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 100, "default": 10},
    "allow_abstention": {"type": "boolean", "default": false},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "rationale": {"type": "string"},
    "notes": {"type": "string"},
    "adjudication": {"$ref": "#/$defs/adjudication"}
  },
  "$defs": {
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "concept_id"],
          "properties": {
            "kind": {"const": "occupation-name"},
            "concept_id": {"type": "string", "minLength": 1},
            "label": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "concept_id", "occupation_name_id"],
          "properties": {
            "kind": {"const": "job-title"},
            "concept_id": {"type": "string", "minLength": 1},
            "occupation_name_id": {"type": "string", "minLength": 1},
            "label": {"type": "string"},
            "occupation_name_label": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "concept_id"],
          "properties": {
            "kind": {"const": "skill"},
            "concept_id": {"type": "string", "minLength": 1},
            "label": {"type": "string"}
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "provenance", "role"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "provenance": {
          "enum": [
            "canonical",
            "canonical_history",
            "curated_relation",
            "derived_af",
            "behavioral",
            "corpus_derived",
            "model_derived",
            "model_judgment",
            "synthetic",
            "human_judgment"
          ]
        },
        "role": {"enum": ["query_origin", "destination_ground_truth", "product_admission", "context_only", "hard_negative"]},
        "ref": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["AUTO_HIGH_CONFIDENCE", "MODEL_ADJUDICATED", "HUMAN_SINGLE", "HUMAN_DOUBLE", "PENDING"]},
        "reviewer_count": {"type": "integer", "minimum": 0},
        "agreement": {"enum": ["UNREVIEWED", "AGREED", "DISAGREED", "RESOLVED"]},
        "review_note": {"type": "string"}
      }
    }
  }
}
